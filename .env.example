# Copier ce fichier en `.env` pour le développement local.
# Toutes les variables VITE_* sont PUBLIQUES par design (inlinées au build) :
# n'y placer aucun secret.

# Sous-chemin de publication de l'application (vidé = racine). Utilisé comme
# basename du routeur et base path Vite.
VITE_BASE_PATH=/
VITE_APP_TITLE=Data React Thon
